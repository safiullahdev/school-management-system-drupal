<?php

use Drupal\node\Entity\Node;
use Drupal\user\Entity\User;
use Drupal\node\NodeInterface;


/**
 * Implements hook_entity_presave().
 */
function school_system_entity_presave(\Drupal\Core\Entity\EntityInterface $entity) {
  if (!$entity instanceof NodeInterface || $entity->bundle() !== 'application') {
    return;
  }
$first_name = $entity->get('field_app_student_first_name')->value ?? '';
$last_name = $entity->get('field_app_student_last_name')->value ?? '';
$app_type = $entity->get('field_app_type')->value ?? '';

$full_name = trim($first_name . ' ' . $last_name);

if ($full_name !== '') {
  $title_parts = [$full_name];

  if ($app_type !== '') {
    $title_parts[] = ucfirst($app_type);
  }

  $entity->setTitle(implode(' - ', $title_parts) . ' Application');
}
}

/**
 * Implements hook_entity_update().
 */
function school_system_entity_update(\Drupal\Core\Entity\EntityInterface $entity) {

static $processing = FALSE;

if ($processing) {
  return;
}

  // Only run for Application nodes.
  if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'application') {
    return;
  }

  \Drupal::messenger()->addMessage('SMD-81: Application update hook is running.');

  if (!$entity->hasField('moderation_state')) {
    \Drupal::messenger()->addMessage('SMD-81: moderation_state field not found.');
    return;
  }

  $status = $entity->get('moderation_state')->value;

  if ($status !== 'approved') {
    \Drupal::messenger()->addMessage('SMD-81: Application is not approved. No student/user created.');
    return;
  }

  $student = NULL;

  // 1. First check if Application already has a linked Student.
  if ($entity->hasField('field_app_created_student') && !$entity->get('field_app_created_student')->isEmpty()) {
    $student = $entity->get('field_app_created_student')->entity;
    \Drupal::messenger()->addMessage('SMD-81: Linked student found on application.');
  }

  // 2. If not linked, check if Student already exists from this Application.
  if (!$student) {
    $existing_students = \Drupal::entityTypeManager()
      ->getStorage('node')
      ->loadByProperties([
        'type' => 'student',
        'field_student_source_application' => $entity->id(),
      ]);

    if (!empty($existing_students)) {
      $student = reset($existing_students);
      \Drupal::messenger()->addMessage('SMD-81: Existing student found by source application.');
    }
  }

  // 3. If no Student exists, create one.
  if (!$student) {
    $student_first_name = $entity->get('field_app_student_first_name')->value ?? '';
    $student_last_name = $entity->get('field_app_student_last_name')->value ?? '';
    $student_title = trim($student_first_name . ' ' . $student_last_name);

    $student = Node::create([
      'type' => 'student',
      'title' => $student_title ?: $entity->getTitle(),
      'field_student_email' => $entity->get('field_app_parent_guardian_email')->value ?? '',
      'field_student_phone' => $entity->get('field_app_parent_guardian_phone')->value ?? '',
      'field_student_source_application' => [
        'target_id' => $entity->id(),
      ],
      'field_student_status' => 'approved',
      'status' => 1,
    ]);

    $student->save();

    $student_id = 'STU-' . str_pad($student->id(), 4, '0', STR_PAD_LEFT);

    if ($student->hasField('field_student_id')) {
      $student->set('field_student_id', $student_id);
      $student->save();
    }

    \Drupal::messenger()->addMessage('SMD-81: Student node created.');
  }

  // 4. Link Student back to Application.
  if ($entity->hasField('field_app_created_student') && $student) {
    $entity->set('field_app_created_student', [
      'target_id' => $student->id(),
    ]);
  }

  // 5. Create or link Student User.
  $email = $entity->get('field_app_parent_guardian_email')->value ?? '';

  if (!empty($email) && $student) {
    $existing_users = \Drupal::entityTypeManager()
      ->getStorage('user')
      ->loadByProperties(['mail' => $email]);

    if (!empty($existing_users)) {
      $user = reset($existing_users);
      \Drupal::messenger()->addMessage('SMD-81: Existing user found.');
    }
    else {
      $student_first_name = $entity->get('field_app_student_first_name')->value ?? '';
      $student_last_name = $entity->get('field_app_student_last_name')->value ?? '';

      $username = strtolower($student_first_name . '.' . $student_last_name . '.' . $student->id());
      $username = preg_replace('/[^a-z0-9_.-]/', '', $username);

      $user = User::create([
        'name' => $username,
        'mail' => $email,
        'pass' => 'Test@123',
        'status' => 1,
        'roles' => ['student'],
      ]);

      $user->save();

      \Drupal::messenger()->addMessage('SMD-81: Student user account created.');
    }

    // Link user to Student node.
    if ($student->hasField('field_student_user')) {
      $student->set('field_student_user', [
        'target_id' => $user->id(),
      ]);
      $student->save();

      \Drupal::messenger()->addMessage('SMD-81: Student user linked to Student node.');
    }
  }
  else {
    \Drupal::messenger()->addMessage('SMD-81: No email found. User account not created.');
  }

 // Save Application updates safely.
$processing = TRUE;
$entity->save();
$processing = FALSE;

\Drupal::messenger()->addMessage('SMD-81: Student/user processing completed.');

  \Drupal::messenger()->addMessage('SMD-81: Student/user processing completed.');
}