<?php

use Drupal\node\Entity\Node;
use Drupal\user\Entity\User;
use Drupal\node\NodeInterface;

use Drupal\user\UserInterface;

/**
 * Implements hook_user_insert().
 */
function school_system_user_insert(UserInterface $account) {
  $account->addRole('parent');
  $account->save();
}

/**
 * Implements hook_entity_presave().
 */
function school_system_entity_presave(\Drupal\Core\Entity\EntityInterface $entity) {
  if (!$entity instanceof NodeInterface) {
    return;
  }

  // Auto-generate Application title.
  if ($entity->bundle() === 'application') {
    $first_name = $entity->get('field_app_student_first_name')->value ?? '';
    $last_name = $entity->get('field_app_student_last_name')->value ?? '';
    $app_type = $entity->get('field_app_type')->value ?? '';

    $full_name = trim($first_name . ' ' . $last_name);

    if ($full_name !== '') {
      $title_parts = [$full_name];

      if ($app_type !== '') {
        $title_parts[] = ucfirst($app_type);
      }

      $entity->setTitle(implode(' - ', $title_parts) . ' Application');
    }
  }

  // Auto-generate Student title.
  if ($entity->bundle() === 'student') {
    $first_name = $entity->get('field_student_first_name')->value ?? '';
    $last_name = $entity->get('field_student_last_name')->value ?? '';

    $student_name = trim($first_name . ' ' . $last_name);

    if ($student_name !== '') {
      $entity->setTitle($student_name);
    }
  }

    // Auto-generate Class title.
  if ($entity->bundle() === 'class') {
    $subject = '';

    if ($entity->hasField('field_class_subject') && !$entity->get('field_class_subject')->isEmpty()) {
      $subject_term = $entity->get('field_class_subject')->entity;
      $subject = $subject_term ? $subject_term->label() : '';
    }

    $grade = $entity->get('field_class_grade_level')->value ?? '';
    $section = $entity->get('field_class_section')->value ?? '';

    $title_parts = array_filter([
      $subject,
      $grade,
      $section ? 'Section ' . $section : '',
    ]);

    if (!empty($title_parts)) {
      $entity->setTitle(implode(' - ', $title_parts));
    }
  }

    // Auto-generate Assignment title.
  if ($entity->bundle() === 'assignment') {
    $assignment_name = $entity->get('field_assignment_name')->value ?? '';
    $class = '';

    if ($entity->hasField('field_assignment_class') && !$entity->get('field_assignment_class')->isEmpty()) {
      $class_node = $entity->get('field_assignment_class')->entity;
      $class = $class_node ? $class_node->label() : '';
    }

    $title_parts = array_filter([
      $assignment_name,
      $class,
    ]);

    if (!empty($title_parts)) {
      $entity->setTitle(implode(' - ', $title_parts));
    }
  }

    // Auto-generate Grade title.
  if ($entity->bundle() === 'grades') {
    $student = '';
    $assignment = '';
    $term = '';

    if ($entity->hasField('field_student') && !$entity->get('field_student')->isEmpty()) {
      $student_node = $entity->get('field_student')->entity;
      $student = $student_node ? $student_node->label() : '';
    }

    if ($entity->hasField('field_grade_assignment') && !$entity->get('field_grade_assignment')->isEmpty()) {
      $assignment_node = $entity->get('field_grade_assignment')->entity;
      $assignment = $assignment_node ? $assignment_node->label() : '';
    }

    if ($entity->hasField('field_grade_term') && !$entity->get('field_grade_term')->isEmpty()) {
      $term_node = $entity->get('field_grade_term')->entity;
      $term = $term_node ? $term_node->label() : '';
    }

    $title_parts = array_filter([
      $student,
      $assignment,
      $term,
    ]);

    if (!empty($title_parts)) {
      $entity->setTitle(implode(' - ', $title_parts));
    }
  }
}

/**
 * Implements hook_entity_update().
 */
function school_system_entity_update(\Drupal\Core\Entity\EntityInterface $entity) {
  static $processing = FALSE;

  if ($processing) {
    return;
  }

  if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'application') {
    return;
  }

  if (!$entity->hasField('moderation_state')) {
    return;
  }

  if ($entity->get('moderation_state')->value !== 'approved') {
    return;
  }

  $student = NULL;

  // 1. Check linked student on application.
  if ($entity->hasField('field_app_created_student') && !$entity->get('field_app_created_student')->isEmpty()) {
    $student = Node::load($entity->get('field_app_created_student')->target_id);
  }

  // 2. Check existing student by source application.
  if (!$student) {
    $existing_students = \Drupal::entityTypeManager()
      ->getStorage('node')
      ->loadByProperties([
        'type' => 'student',
        'field_student_source_application' => $entity->id(),
      ]);

    if (!empty($existing_students)) {
      $student = reset($existing_students);
    }
  }

  // 3. Create student node if needed.
  if (!$student) {
    $student_first_name = $entity->get('field_app_student_first_name')->value ?? '';
    $student_last_name = $entity->get('field_app_student_last_name')->value ?? '';
    $student_title = trim($student_first_name . ' ' . $student_last_name);

    $student = Node::create([
      'type' => 'student',
      'title' => $student_title ?: $entity->getTitle(),
      'field_student_first_name' => $student_first_name,
      'field_student_last_name' => $student_last_name,
      'field_student_dob' => $entity->get('field_app_student_dob')->value ?? '',
      'field_student_gender' => $entity->get('field_app_student_gender')->value ?? '',
      'field_student_email' => $entity->get('field_app_student_email')->value ?? '',
      'field_student_phone' => $entity->get('field_app_parent_guardian_phone')->value ?? '',
      'field_student_address' => $entity->get('field_app_street_address')->getValue(),
      'field_student_emergency_contact' => $entity->get('field_app_parent_guardian_name')->value ?? '',
      'field_student_emergency_phone' => $entity->get('field_app_parent_guardian_phone')->value ?? '',
      'field_student_source_application' => ['target_id' => $entity->id()],
      'field_student_status' => 'enrolled',
      'field_student_enrollment_date' => date('Y-m-d'),
      'status' => 1,
    ]);

    $student->save();

    if ($student->hasField('field_student_id')) {
      $student_id = 'STU-' . str_pad($student->id(), 4, '0', STR_PAD_LEFT);
      $student->set('field_student_id', $student_id);
      $student->save();
    }
  }

  // 4. Link student back to application.
  if ($entity->hasField('field_app_created_student') && $student) {
    $entity->set('field_app_created_student', ['target_id' => $student->id()]);
  }
  // 5. Parent/student user mapping.
  $author = User::load($entity->getOwnerId());

  if ($author && $student) {
    $roles = $author->getRoles();

    // Parent-submitted application.
    if (in_array('parent', $roles, TRUE)) {
      if ($student->hasField('field_student_parent_user')) {
        $student->set('field_student_parent_user', ['target_id' => $author->id()]);
      }

      $student_email = $entity->hasField('field_app_student_email')
        ? trim((string) $entity->get('field_app_student_email')->value)
        : '';

      if ($student_email !== '') {
        $existing_users = \Drupal::entityTypeManager()
          ->getStorage('user')
          ->loadByProperties(['mail' => $student_email]);

        if (!empty($existing_users)) {
          $student_user = reset($existing_users);
        }
        else {
          $student_first_name = $entity->get('field_app_student_first_name')->value ?? '';
          $student_last_name = $entity->get('field_app_student_last_name')->value ?? '';

          $username = strtolower($student_first_name . '.' . $student_last_name . '.' . $student->id());
          $username = preg_replace('/[^a-z0-9_.-]/', '', $username);

          $student_user = User::create([
            'name' => $username,
            'mail' => $student_email,
            'pass' => 'Test@123',
            'status' => 1,
          ]);

          $student_user->save();
        }

        // Ensure this account is treated as a student account only.
        $student_user->addRole('student');
        $student_user->removeRole('parent');
        $student_user->save();

        if ($student->hasField('field_student_user')) {
          $student->set('field_student_user', ['target_id' => $student_user->id()]);
        }
      }

      $student->save();
      \Drupal::messenger()->addMessage('SMD-188: Parent linked and student user processed.');
    }

    // Student-submitted application.
    elseif (in_array('student', $roles, TRUE)) {
      if ($student->hasField('field_student_user')) {
        $student->set('field_student_user', ['target_id' => $author->id()]);
        $student->save();
      }

      \Drupal::messenger()->addMessage('SMD-188: Student user linked.');
    }
  }
  // 6. Save application update safely.
  $processing = TRUE;
  $entity->save();
  $processing = FALSE;

      \Drupal::messenger()->addMessage('SMD-188: Student processing completed.');
}