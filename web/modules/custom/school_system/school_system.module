<?php

use Drupal\node\Entity\Node;

/**
 * Implements hook_entity_update().
 */
function school_system_entity_update(\Drupal\Core\Entity\EntityInterface $entity) {

  // Only for Application nodes.
  if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'application') {
    return;
  }

  \Drupal::messenger()->addMessage('SMD-40: Application update hook is running.');

  // Check application workflow state.
  if (!$entity->hasField('moderation_state')) {
    \Drupal::messenger()->addMessage('SMD-40: moderation_state field not found.');
    return;
  }

  $status = $entity->get('moderation_state')->value;

  \Drupal::messenger()->addMessage('SMD-40: Application state is ' . $status);

  // Only continue if Approved.
  if ($status !== 'approved') {
    \Drupal::messenger()->addMessage('SMD-40: Application is not approved. Student not created.');
    return;
  }
  // Prevent duplicate student creation.
  if ($entity->hasField('field_app_created_student') && !$entity->get('field_app_created_student')->isEmpty()) {
    \Drupal::messenger()->addMessage('SMD-40: Application already has a created student.');
    return;
  }

  // Check if student already exists for this application.
  $existing = \Drupal::entityTypeManager()
    ->getStorage('node')
    ->loadByProperties([
      'type' => 'student',
      'field_student_source_application' => $entity->id(),
    ]);

  if (!empty($existing)) {
    \Drupal::messenger()->addMessage('SMD-40: Student already exists for this application.');
    return;
  }

  $student_first_name = $entity->get('field_app_student_first_name')->value ?? '';
  $student_last_name = $entity->get('field_app_student_last_name')->value ?? '';
  $student_title = trim($student_first_name . ' ' . $student_last_name);

  $student = Node::create([
    'type' => 'student',
    'title' => $student_title ?: $entity->getTitle(),
    'field_student_email' => $entity->get('field_app_parent_guardian_email')->value ?? '',
    'field_student_phone' => $entity->get('field_app_parent_guardian_phone')->value ?? '',
    'field_student_source_application' => [
      'target_id' => $entity->id(),
    ],
    'field_student_status' => 'approved',
    'status' => 1,
  ]);

$student->save();

\Drupal::messenger()->addMessage('SMD-40: Student created successfully from approved application.');

$student_id = 'STU-' . str_pad($student->id(), 4, '0', STR_PAD_LEFT);

$student->set('field_student_id', $student_id);
$student->save();

// Save reference to the created Student on the Application node.
if ($entity->hasField('field_app_created_student')) {
  $entity->set('field_app_created_student', [
    'target_id' => $student->id(),
  ]);
  $entity->save();
}

\Drupal::messenger()->addMessage('SMD-41: Student ID generated: ' . $student_id);
}