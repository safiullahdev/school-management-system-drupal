<?php

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;

/**
 * Implements hook_form_FORM_ID_alter().
 */
function school_dashboard_form_user_login_form_alter(array &$form, FormStateInterface $form_state, string $form_id): void {
  $form['#submit'][] = 'school_dashboard_user_login_redirect_submit';
}

/**
 * Redirect students to the Student Dashboard after login.
 */
function school_dashboard_user_login_redirect_submit(array &$form, FormStateInterface $form_state): void {
  $account = \Drupal::currentUser();
  $roles = $account->getRoles();

  if (!is_array($roles)) {
    return;
  }

  if (in_array('student', $roles, TRUE)) {
    $form_state->setRedirectUrl(Url::fromUserInput('/student-dashboard'));
    return;
  }

  if (in_array('teacher', $roles, TRUE)) {
    $form_state->setRedirectUrl(Url::fromUserInput('/teacher-dashboard'));
    return;
  }

  if (in_array('registrar', $roles, TRUE)) {
    $form_state->setRedirectUrl(Url::fromUserInput('/registrar-dashboard'));
    return;
  }

  if (in_array('admin', $roles, TRUE)) {
    $form_state->setRedirectUrl(Url::fromUserInput('/school-admin-dashboard'));
    return;
  }
  
  if (in_array('parent', $roles, TRUE)) {
    $form_state->setRedirectUrl(Url::fromUserInput('/parent-dashboard'));
    return;
  }
}