{% import _self as menus %}

{{ menus.menu_links(items, attributes, 0) }}

{% macro menu_links(items, attributes, menu_level) %}
  {% import _self as menus %}

  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('menu', 'menu--main', 'nav', 'navbar-nav') }}>
    {% else %}
      <ul class="menu">
    {% endif %}

    {% for item in items %}
      {% set title = item.title|render|striptags|trim %}
      {% set current_path = path('<current>') %}
      {% set item_path = item.url.toString() %}
      {% set is_active = item.in_active_trail or item_path == current_path %}

      <li class="{{ is_active ? 'active-trail' }}">
        <a href="{{ item.url }}" class="shk-menu-link{{ is_active ? ' is-active' }}">
          <span class="shk-menu-link__text">{{ title }}</span>
        </a>

        {% if item.below %}
          {{ menus.menu_links(item.below, attributes, menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}

    </ul>
  {% endif %}
{% endmacro %}