{#
/**
 * @file
 * Default page template for Mosafi Theme.
 */
#}

<div class="mosafi-page">

  {# {% if page.header %}
    <header class="mosafi-site-header" role="banner">
      <div class="mosafi-container">
        {{ page.header }}
      </div>
    </header>
  {% endif %} #}
  {% if page.header or mosafi_user_menu.show %}
  <header class="mosafi-site-header" role="banner">
    <div class="mosafi-container mosafi-header-inner">

      {% if page.header %}
        <div class="mosafi-header-branding">
          {{ page.header }}
        </div>
      {% endif %}

      {% if mosafi_user_menu.show %}
        <nav
          class="mosafi-user-menu"
          aria-label="{{ 'User account'|t }}"
        >
          <a
            class="mosafi-user-menu__account"
            href="{{ mosafi_user_menu.account_url }}"
          >
            {{ mosafi_user_menu.display_name }}
          </a>

          <a
            class="mosafi-user-menu__logout"
            href="{{ mosafi_user_menu.logout_url }}"
          >
            {{ 'Log out'|t }}
          </a>
        </nav>
      {% endif %}

    </div>
  </header>
{% endif %}

  {% if page.primary_menu %}
    <nav class="mosafi-site-nav" role="navigation" aria-label="{{ 'Main navigation'|t }}">
      <div class="mosafi-container">
        {{ page.primary_menu }}
      </div>
    </nav>
  {% endif %}

  {% if page.hero %}
    <section class="mosafi-hero-region">
      {{ page.hero }}
    </section>
  {% endif %}

  {% if page.highlighted %}
    <section class="mosafi-highlighted">
      <div class="mosafi-container">
        {{ page.highlighted }}
      </div>
    </section>
  {% endif %}

  {% if page.help %}
    <section class="mosafi-help">
      <div class="mosafi-container">
        {{ page.help }}
      </div>
    </section>
  {% endif %}

  <main id="main-content" class="mosafi-main" role="main">
    <div class="mosafi-container mosafi-layout">
      {% if page.sidebar_first %}
        <aside class="mosafi-sidebar mosafi-sidebar--first" role="complementary">
          {{ page.sidebar_first }}
        </aside>
      {% endif %}

      <section class="mosafi-content">
        {{ page.content }}
      </section>

      {% if page.sidebar_second %}
        <aside class="mosafi-sidebar mosafi-sidebar--second" role="complementary">
          {{ page.sidebar_second }}
        </aside>
      {% endif %}
    </div>
  </main>

  {% if page.footer %}
    <footer class="mosafi-site-footer" role="contentinfo">
      <div class="mosafi-container">
        {{ page.footer }}
      </div>
    </footer>
  {% endif %}

</div>